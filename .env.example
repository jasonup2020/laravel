# 应用配置
APP_NAME="SaaS Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel-saas-ultimate-pro-full.test.com

# 日志配置
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 数据库配置
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_saas
DB_USERNAME=laravel_saas
DB_PASSWORD=aesRs7T4S2

# Redis配置
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3

# 缓存配置
CACHE_DRIVER=redis
CACHE_PREFIX=saas_

# 文件系统配置
FILESYSTEM_DISK=local

# 队列配置
QUEUE_CONNECTION=redis

# Session配置
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# 广播配置
BROADCAST_CONNECTION=redis

# Mail配置
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS配置（可选）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher配置（可选）
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite配置
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# JWT配置
JWT_SECRET=
JWT_ALGO=HS256
JWT_ACCESS_TOKEN_TTL=120
JWT_REFRESH_TOKEN_TTL=10080
JWT_BLACKLIST_TTL=604800

# 多租户配置
SAAS_TENANT_ENABLED=true
SAAS_TENANT_ISOLATION_MODE=column
SAAS_TENANT_DATABASE_PREFIX=tenant_
SAAS_TENANT_DOMAIN_SUFFIX=
SAAS_TENANT_AUTO_CREATE_DATABASE=false

# 单设备登录配置
SINGLE_DEVICE_LOGIN_ENABLED=false

# 权限配置
PERMISSION_ENABLED=true

# 限流配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_LOGIN=10

# 文件上传配置
UPLOAD_DISK=local
UPLOAD_MAX_SIZE=10485760

# 日志开关
REQUEST_LOG_ENABLED=true
RESPONSE_LOG_ENABLED=false
SQL_LOG_ENABLED=false

# 设备管理配置
DEVICE_ENABLED=true
DEVICE_MAX_COUNT=5

# 多语言配置
APP_LOCALE=zh
APP_FALLBACK_LOCALE=en
APP_AVAILABLE_LOCALES=zh,en,ko

# 时区配置
APP_TIMEZONE=Asia/Shanghai

# 调试工具（仅开发环境）
DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
